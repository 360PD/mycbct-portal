4:["$","li",null,{"children":"The referrer/prescriber accepts the responsibility to ensure that they are competent and adequately trained to interpret/report, and that their training remains current."}]
5:["$","section",null,{"className":"tm-card","children":[["$","h2",null,{"className":"tm-h2","children":"3. Data Protection"}],["$","p",null,{"className":"tm-p","children":"360 Visualise Limited processes patient data in accordance with UK GDPR and the Data Protection Act 2018. Patient data is used solely for the purpose of providing the requested imaging service and will not be shared with third parties without consent, except where required by law."}]]}]
6:["$","section",null,{"className":"tm-card","children":[["$","h2",null,{"className":"tm-h2","children":"4. Payment & DNA Policy"}],["$","p",null,{"className":"tm-p","children":"Payment for all scans is due on the day of the appointment. In the event that a patient does not attend (DNA) their appointment without providing at least 24 hours notice, a cancellation fee of £25 may be charged to the referring practice. We understand that circumstances change and will always try to be reasonable — please contact us as soon as possible if your patient is unable to attend."}]]}]
b:T4e3,
        .tm{min-height:100vh;background:#0e1b2e;color:#f7f4ec;
          font-family:'DM Sans',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
          padding:40px 24px 80px;}
        .tm-inner{max-width:760px;margin:0 auto;}
        .tm-back{display:inline-block;color:rgba(247,244,236,.6);text-decoration:none;
          font-size:14px;margin-bottom:24px;}
        .tm-back:hover{color:#e7ae3b;}
        .tm-head{margin-bottom:28px;}
        .tm-sub{margin:0 0 10px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
          color:#e7ae3b;font-weight:600;}
        .tm-h1{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:clamp(28px,5vw,34px);
          margin:0;line-height:1.2;}
        .tm-card{background:rgba(247,244,236,.04);border:1px solid rgba(247,244,236,.08);
          border-radius:16px;padding:24px 26px;margin-bottom:18px;}
        .tm-h2{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:18px;
          margin:0 0 14px;color:#e7ae3b;}
        .tm-p{margin:0;font-size:15px;line-height:1.65;color:rgba(247,244,236,.88);}
        .tm-list{margin:0;padding-left:20px;font-size:15px;line-height:1.65;
          color:rgba(247,244,236,.88);}
        .tm-list li + li{margin-top:10px;}
