["$","section",null,{"className":"tm-card","children":[["$","h2",null,{"className":"tm-h2","children":"2. Reporting and Interpreting Agreement"}],["$","ul",null,{"className":"tm-list","children":[["$","li",null,{"children":"360 Visualise do not report on CBCT scans or x-rays as a matter of standard procedure."}],["$","li",null,{"children":"360 Visualise can arrange for scans and x-rays to be reported on by a consultant radiologist."}],["$","li",null,{"children":"The referrer/prescriber accepts responsibility for making arrangements for all radiographs and CBCT scans to be interpreted and reported on."}],"$L4"]}]]}],"$L5","$L6"]}],"$L7"]}],null,"$L8"]}],{},null,false]},null,false]},null,false],"$L9",false]],"m":"$undefined","G":["$a",[]],"s":false,"S":true}
